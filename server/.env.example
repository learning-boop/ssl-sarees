# Local MongoDB (if you install MongoDB Community Server yourself), OR
# a free MongoDB Atlas connection string — see BACKEND_SETUP.md for how
# to get one. Format looks like:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ssl-sarees
MONGODB_URI="mongodb://localhost:27017/ssl-sarees"

# Change to a long random string in production
JWT_SECRET="replace-this-with-a-long-random-secret"

# How long login sessions last
JWT_EXPIRES_IN="7d"

# Server port
PORT=5000

# Comma-separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:5173"

# Used only by the seed script to create the first admin account
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@sslsarees.com"
ADMIN_PASSWORD="ChangeMe123!"
